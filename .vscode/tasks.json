{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Cargo build quicview workspace",
			"type": "shell",
			"command": "cargo build --workspace",
			"args": [],
			"problemMatcher": [
				"$rustc"
			],
			"group": "build"
		},
		{
			"label": "Build QuicView workspace",
			"type": "shell",
			"command": "cargo build --workspace",
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "cargo build quicview workspace (no upstream)",
			"type": "shell",
			"command": "cargo build -q",
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "cargo build (quicview)",
			"type": "shell",
			"command": "cargo build -q",
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "Build workspace",
			"type": "shell",
			"command": "cargo build",
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "cleanup server src",
			"type": "shell",
			"command": "git rm -f crates/server/src/{audio_service.rs,clipboard_service.rs,connection.rs,dbus.rs,display_service.rs,input_service.rs,portable_service.rs,printer_service.rs,rdp_input.rs,service.rs,terminal_service.rs,uinput.rs,video_qos.rs,video_service.rs,wayland.rs,lib.rs} || true",
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "Build server and run minimal binary",
			"type": "shell",
			"command": "cargo build -p server && target/debug/server --listen 127.0.0.1:22116 --health 127.0.0.1:23000",
			"problemMatcher": [
				"$rustc"
			],
			"group": "build"
		},
		{
			"label": "build-and-test-quicview",
			"type": "shell",
			"command": "cargo test --workspace",
			"problemMatcher": [
				"$rustc"
			],
			"group": "build"
		},
		{
			"label": "Build quicview only",
			"type": "shell",
			"command": "cargo build --all-features",
			"args": [],
			"problemMatcher": [
				"$rustc"
			],
			"group": "build"
		},
		{
			"label": "Build quicview",
			"type": "shell",
			"command": "cargo build --all-features",
			"args": [],
			"problemMatcher": [
				"$rustc"
			],
			"group": "build"
		}
	]
}